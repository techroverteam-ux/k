# ---- TradeDesk API (development example) ----
# Copy to .env and replace every secret. In production, inject these from a secrets manager (AWS Secrets Manager / GCP Secret Manager / Vault).
NODE_ENV=development
PORT=4000
APP_NAME=The K
DATABASE_URL=postgresql://tradedesk:tradedesk_dev@127.0.0.1:5432/tradedesk
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_STEPUP_SECRET=change-me-stepup-secret-at-least-32-characters-long
HASH_PEPPER=change-me-pepper-at-least-32-characters-long-xxxxx
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
SMS_PROVIDER=dev
COOKIE_SECURE=false
TRUST_PROXY=false
# Must stay false: no licensed broker/exchange integration in this build.
LIVE_TRADING_ENABLED=false
MARKET_FEED=simulated
# dev seed accounts password (scripts/seed.ts)
SEED_PASSWORD=Dev-Only-Passw0rd!
# ---- logging ----
# Daily archives of the audit trail + activity log (NDJSON.gz + SHA-256 manifest). Use WORM storage in production.
LOG_ARCHIVE_DIR=./log-archive
LOG_MAINTENANCE=on
# json (default in production) | pretty
# LOG_FORMAT=json
# also print one JSON line per API request to stdout (for CloudWatch/Loki/ELK)
LOG_REQUESTS_STDOUT=false
# Set true ONLY when the API is reachable exclusively through your load balancer, so X-Forwarded-For is trusted.
# TRUST_PROXY=false

# Market sessions come from Configuration (trading.marketHours). For local development at any hour
# you may set always_open; production refuses it.
MARKET_HOURS=config
