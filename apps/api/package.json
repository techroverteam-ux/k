{
  "name": "@tradedesk/api",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "dotenv -e .env -- ts-node-dev --respawn --transpile-only src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- ts-node --transpile-only scripts/migrate.ts",
    "db:seed": "dotenv -e .env -- ts-node --transpile-only scripts/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "dotenv -e .env.test -- jest --runInBand",
    "logs:archive": "dotenv -e .env -- ts-node --transpile-only scripts/archive-logs.ts archive",
    "logs:verify": "dotenv -e .env -- ts-node --transpile-only scripts/archive-logs.ts verify"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/graphql-depth-limit": "1.1.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "dotenv-cli": "8.0.0",
    "drizzle-kit": "0.31.11",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/graphql": "13.4.5",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/throttler": "6.7.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dataloader": "2.2.3",
    "drizzle-orm": "0.45.4",
    "graphql": "16.14.2",
    "graphql-depth-limit": "1.1.0",
    "graphql-query-complexity": "2.0.0",
    "graphql-subscriptions": "3.0.0",
    "graphql-ws": "6.4.1",
    "helmet": "8.3.0",
    "otplib": "12.0.1",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.22.0",
    "zod": "4.6.7"
  }
}
